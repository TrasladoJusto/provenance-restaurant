# PROVENANCE Restaurant - Environment Variables
# Copy this file to .env.local and fill in your values

# Resend (Email Service)
RESEND_API_KEY=re_xxxxxxxxxxxxx

# Database (if using)
# DATABASE_URL=postgresql://user:pass@host:5432/db

# Analytics
# PLAUSIBLE_DOMAIN=provenance-restaurant.com
# PLAUSIBLE_API_HOST=https://plausible.io

# Cloudflare (for Workers deployment)
# CF_ACCOUNT_ID=your-account-id
# CF_API_TOKEN=your-api-token

# Site URL (for sitemap, canonical URLs, etc.)
NEXT_PUBLIC_SITE_URL=https://provenance-restaurant.com